<resources>
    <style name="Theme.JustProxy" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">@color/navy</item>
        <item name="android:navigationBarColor">@color/navy</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">@color/teal_dark</item>
        <item name="android:windowBackground">@color/off_white</item>
    </style>

    <style name="JustProxy" />

    <style name="JustProxy.Card">
        <item name="android:background">@drawable/card_background</item>
        <item name="android:elevation">2dp</item>
        <item name="android:padding">18dp</item>
    </style>

    <style name="JustProxy.SectionTitle">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">19sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="JustProxy.MetricValue">
        <item name="android:textColor">@color/navy</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="JustProxy.Caption">
        <item name="android:textColor">@color/slate</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="JustProxy.Button" parent="android:style/Widget.Material.Button">
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:backgroundTint">@color/button_secondary_background</item>
        <item name="android:textColor">@color/button_secondary_text</item>
    </style>

    <style name="JustProxy.Switch" parent="android:style/Widget.Material.CompoundButton.Switch">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingTop">6dp</item>
        <item name="android:paddingBottom">6dp</item>
        <item name="android:switchPadding">14dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/navy</item>
    </style>

    <style name="JustProxy.Input" parent="android:style/Widget.Material.EditText">
        <item name="android:minHeight">48dp</item>
        <item name="android:textSize">16sp</item>
        <item name="android:importantForAutofill">no</item>
    </style>
</resources>
