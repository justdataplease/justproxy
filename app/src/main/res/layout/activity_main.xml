<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/off_white"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/navy"
            android:orientation="vertical"
            android:paddingStart="22dp"
            android:paddingTop="28dp"
            android:paddingEnd="22dp"
            android:paddingBottom="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="JUSTPROXY"
                android:textColor="@color/teal"
                android:textSize="13sp"
                android:textStyle="bold"
                android:letterSpacing="0.18" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Your phone. Your connection."
                android:textColor="@color/white"
                android:textSize="27sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="7dp"
                android:text="An encrypted WireGuard gateway plus authenticated HTTP + SOCKS5 proxy, with cellular routing and private analytics."
                android:textColor="#BFD0DC"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <LinearLayout
                style="@style/JustProxy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/JustProxy.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="JustProxy service" />

                    <TextView
                        android:id="@+id/statusChip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/status_stopped"
                        android:text="STOPPED"
                        android:textColor="@color/slate"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/statusMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Proxy is off"
                    android:textColor="@color/slate"
                    android:textSize="14sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/startStopButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/teal_dark"
                        android:text="Start JustProxy"
                        android:textColor="@color/white"
                        android:textStyle="bold" />

                    <Button
                        android:id="@+id/rotateButton"
                        android:layout_width="0dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="10dp"
                        android:layout_weight="1"
                        android:backgroundTint="@color/navy_surface"
                        android:enabled="false"
                        android:text="Reconnect"
                        android:textColor="@color/white" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/JustProxy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/JustProxy.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="WireGuard gateway - Beta" />

                <TextView
                    android:id="@+id/wireGuardStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Disabled"
                    android:textColor="@color/slate"
                    android:textSize="14sp" />

                <TextView
                    android:id="@+id/wireGuardEndpointText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:fontFamily="monospace"
                    android:text="No LAN / hotspot endpoint detected"
                    android:textColor="@color/navy"
                    android:textIsSelectable="true"
                    android:textSize="15sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/wireGuardTrafficText"
                    style="@style/JustProxy.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="0 active flows  |  0 B this run" />

                <TextView
                    style="@style/JustProxy.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Import the exported .conf into the official WireGuard app on your computer. One computer profile is supported in this beta." />

                <Button
                    android:id="@+id/manageWireGuardButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Create / export computer profile" />
            </LinearLayout>

            <LinearLayout
                style="@style/JustProxy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/JustProxy.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Legacy HTTP / SOCKS5 proxy - Optional" />

                <TextView
                    android:id="@+id/endpointText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="USB: 127.0.0.1:8282"
                    android:textColor="@color/navy"
                    android:textIsSelectable="true"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/controlEndpointText"
                    style="@style/JustProxy.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Control API: 127.0.0.1:8283" />

                <TextView
                    style="@style/JustProxy.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="USERNAME" />

                <TextView
                    android:id="@+id/usernameText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/navy"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />

                <TextView
                    style="@style/JustProxy.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="PASSWORD / API TOKEN" />

                <TextView
                    android:id="@+id/passwordText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="monospace"
                    android:textColor="@color/navy"
                    android:textIsSelectable="true"
                    android:textSize="15sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/copyButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Copy setup" />

                    <Button
                        android:id="@+id/regenerateButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:text="New secret" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/JustProxy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/JustProxy.SectionTitle"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Traffic analyzer" />

                    <Button
                        android:id="@+id/refreshIpButton"
                        android:layout_width="wrap_content"
                        android:layout_height="40dp"
                        android:minWidth="0dp"
                        android:text="Check IP" />
                </LinearLayout>

                <TextView
                    style="@style/JustProxy.Caption"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="PUBLIC EGRESS IP" />

                <TextView
                    android:id="@+id/publicIpText"
                    style="@style/JustProxy.MetricValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="-" />

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:columnCount="2"
                    android:rowCount="2">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">
                        <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="THIS RUN" />
                        <TextView android:id="@+id/runTrafficText" style="@style/JustProxy.MetricValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 B" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:orientation="vertical">
                        <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="TODAY" />
                        <TextView android:id="@+id/todayTrafficText" style="@style/JustProxy.MetricValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 B" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="14dp"
                        android:layout_marginEnd="8dp"
                        android:orientation="vertical">
                        <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="LIFETIME" />
                        <TextView android:id="@+id/lifetimeTrafficText" style="@style/JustProxy.MetricValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 B" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_columnWeight="1"
                        android:layout_marginTop="14dp"
                        android:orientation="vertical">
                        <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ACTIVE" />
                        <TextView android:id="@+id/activeConnectionsText" style="@style/JustProxy.MetricValue" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0 clients" />
                    </LinearLayout>
                </GridLayout>

                <TextView
                    android:id="@+id/analyticsDetailText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Upload 0 B  |  Download 0 B  |  0 IP changes"
                    android:textColor="@color/slate"
                    android:textSize="13sp" />

                <Button
                    android:id="@+id/activityButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="View IP &amp; session history" />
            </LinearLayout>

            <LinearLayout
                style="@style/JustProxy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/JustProxy.SectionTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Automatic IP rotation - Shizuku" />

                <Switch
                    android:id="@+id/shizukuRotationSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:text="Enable automatic mobile-data cycling" />

                <TextView
                    android:id="@+id/shizukuStatusText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Shizuku setup required"
                    android:textColor="@color/slate"
                    android:textSize="14sp" />

                <TextView
                    style="@style/JustProxy.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Optionally turns mobile data off briefly, then restores it. Cellular-only mode and Shizuku permission are required; a new carrier IP is not guaranteed." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/JustProxy.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="INTERVAL, MINUTES (1–1440)" />

                        <EditText
                            android:id="@+id/shizukuIntervalInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="60"
                            android:inputType="number"
                            android:maxLength="4"
                            android:singleLine="true" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/JustProxy.Caption"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="DATA-OFF TIME, SECONDS (1–10)" />

                        <EditText
                            android:id="@+id/shizukuDataOffInput"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number"
                            android:maxLength="2"
                            android:singleLine="true"
                            android:text="1" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    style="@style/JustProxy.Caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Default data-off time: 1 second. If Android interrupts recovery, turn mobile data back on manually." />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/shizukuSetupButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Set up Shizuku" />

                    <Button
                        android:id="@+id/shizukuRotateNowButton"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:layout_weight="1"
                        android:enabled="false"
                        android:text="Rotate now" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                style="@style/JustProxy.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp"
                android:orientation="vertical">

                <TextView
                    style="@style/JustProxy.SectionTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Controls" />

                <Switch
                    android:id="@+id/wireGuardEnabledSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Enable WireGuard gateway (full computer traffic)" />

                <Switch
                    android:id="@+id/legacyProxyEnabledSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Enable legacy HTTP / SOCKS5 proxy" />

                <Switch
                    android:id="@+id/lanAccessSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Legacy proxy/control: allow LAN clients" />

                <Switch
                    android:id="@+id/cellularOnlySwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:checked="true"
                    android:text="Cellular-only egress (fail closed)" />

                <Switch
                    android:id="@+id/privateDestinationsSwitch"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Legacy proxy: allow private / LAN destinations" />

                <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="WIREGUARD UDP PORT" />
                <EditText android:id="@+id/wireGuardPortInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="5" android:singleLine="true" />

                <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="PROXY PORT" />
                <EditText android:id="@+id/portInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="5" android:singleLine="true" />

                <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="RECONNECT SESSIONS EVERY N MINUTES (0 = OFF)" />
                <EditText android:id="@+id/rotationInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="4" android:singleLine="true" />

                <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="IDLE TIMEOUT, SECONDS" />
                <EditText android:id="@+id/idleInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="4" android:singleLine="true" />

                <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="MAXIMUM CONNECTIONS" />
                <EditText android:id="@+id/maxConnectionsInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="2" android:singleLine="true" />

                <TextView style="@style/JustProxy.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="STOP AFTER MIB THIS RUN (0 = UNLIMITED)" />
                <EditText android:id="@+id/dataCapInput" android:layout_width="match_parent" android:layout_height="wrap_content" android:inputType="number" android:maxLength="7" android:singleLine="true" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:text="Reconnect closes active TCP sessions; it does not guarantee a new carrier IP. JustProxy verifies the public IP and reports the real result."
                    android:textColor="@color/slate"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingBottom="24dp"
                android:text="Use only on devices, networks, and services you are authorized to access. WireGuard traffic is encrypted; legacy proxy authentication is not, so use that mode only over a trusted LAN or USB."
                android:textColor="@color/slate"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
